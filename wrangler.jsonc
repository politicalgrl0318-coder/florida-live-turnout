{
  "$schema": "./305-DATA-GIRL-DASHBOARD/node_modules/wrangler/config-schema.json",
  "name": "florida-live-turnout",
  "main": "./305-DATA-GIRL-DASHBOARD/dist/server/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./305-DATA-GIRL-DASHBOARD/dist/client"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "RESULTS_REFRESH_SECONDS": "30"
  }
}
