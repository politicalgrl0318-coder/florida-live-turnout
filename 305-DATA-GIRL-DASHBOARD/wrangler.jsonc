{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "florida-live-turnout",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-13",
  "vars": {
    "RESULTS_REFRESH_SECONDS": "30"
  },
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
